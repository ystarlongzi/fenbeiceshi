# 生产站点模板：初始化脚本替换 __DOMAIN__、__DEPLOY_PATH__、__CERT_ROOT__。
# 放入主配置 http 块已加载的目录，不单独作为完整 nginx.conf 使用。
__REDIRECT_MAP__
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ www.__DOMAIN__;
    __REDIRECT_RULE__
    return 301 https://__DOMAIN__$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.__DOMAIN__;
    __REDIRECT_RULE__
    ssl_certificate __CERT_ROOT__/__DOMAIN__/fullchain.cer;
    ssl_certificate_key __CERT_ROOT__/__DOMAIN__/__DOMAIN__.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 301 https://__DOMAIN__$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;
    __REDIRECT_RULE__
    # 发布只切换 current 指向的版本，无需每次 reload Nginx。
    root __DEPLOY_PATH__/current;
    index index.html;
    charset utf-8;

    ssl_certificate __CERT_ROOT__/__DOMAIN__/fullchain.cer;
    ssl_certificate_key __CERT_ROOT__/__DOMAIN__/__DOMAIN__.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:__SITE_KEY___ssl:10m;
    ssl_session_timeout 1d;

    access_log /var/log/nginx/__SITE_KEY__.access.log;
    error_log /var/log/nginx/__SITE_KEY__.error.log warn;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(self), geolocation=()" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json application/xml image/svg+xml;

    location / {
        expires -1;
        try_files $uri $uri/ =404;
    }

    # 保留旧哈希资源，避免切版后已打开的页面加载失败。
    location ^~ /_next/static/ {
        alias __DEPLOY_PATH__/shared/_next/static/;
        add_header Cache-Control "public, max-age=31536000, immutable";
        # location 内设置 add_header 后不会继承 server 的响应头。
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(self), geolocation=()" always;
    }

    # 发布健康检查依赖准确的版本号，不能让代理或浏览器缓存这个标记。
    location = /_release.txt {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Permissions-Policy "camera=(), microphone=(self), geolocation=()" always;
        try_files $uri =404;
    }

    location ~ /\. {
        deny all;
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
        expires -1;
    }
}
