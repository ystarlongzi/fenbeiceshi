# 复制为 deploy/.env.local 后填写；只按数据解析，不执行 Shell。
# 命令参数优先于环境变量，环境变量优先于本文件；Actions 使用 Secrets 与 Variables。
SSH_HOST=server.example.com
SSH_USER=root
SSH_PORT=22
SSH_PRIVATE_KEY_FILE=~/.ssh/id_ed25519
# 填写已核验的服务器主机公钥文件；省略时本机采用 accept-new，生产 Actions 必填。
SSH_KNOWN_HOSTS_FILE=~/.ssh/known_hosts

DOMAIN=fenbeiceshi.com
DEPLOY_PATH=/www/wwwroot/fenbeiceshi

# 以下为服务器路径。Nginx 主配置必须已经 include 此目录的 *.conf。
NGINX_CONF_PATH=/etc/nginx/conf.d
CERT_ROOT=/etc/nginx/ssl
DNS_ENV_FILE=/etc/fenbeiceshi/cloudflare.env
ACME_HOME=/root/.acme.sh-fenbeiceshi
SSL_EMAIL=admin@example.com

# 仅本机 --bootstrap 读取；文件须为 600 或 400。不要在此填写 Token。
DNS_CREDENTIALS_FILE=deploy/cloudflare.local
