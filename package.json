{
  "name": "fenbeiceshi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <27"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 31031",
    "preview": "node scripts/preview.mjs",
    "build": "node scripts/build-sites.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "node scripts/run-tests.mjs",
    "test:content": "node --experimental-strip-types scripts/i18n/check-messages.mjs && node --experimental-strip-types scripts/check-content.ts",
    "test:export": "node scripts/check-sites.mjs",
    "test:deploy": "node --test deploy/tests/*.test.mjs",
    "test:deploy:integration": "node deploy/tests/run-integration.mjs",
    "deploy:pack": "node deploy/pack-static.mjs",
    "deploy:setup": "node deploy/setup-server.mjs",
    "deploy:static": "node deploy/deploy-static.mjs",
    "deploy:rollback": "node deploy/deploy-static.mjs --rollback",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:deploy && npm run test:content && npm run build && npm run test:export"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "jspdf": "4.2.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "6.2.6",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
